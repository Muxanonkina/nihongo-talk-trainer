generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String         @id @default(uuid())
  email       String         @unique
  password    String
  name        String?
  level       String         @default("N5")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  progress    UserProgress[]
  jlptResults JLPTResult[]
}

model Dialog {
  id         String         @id @default(uuid())
  title      String
  category   String
  difficulty String
  script     String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  progress   UserProgress[]
}

model UserProgress {
  id        String   @id @default(uuid())
  userId    String
  dialogId  String
  score     Int
  feedback  String?
  createdAt DateTime @default(now())
  messages  String?
  dialog    Dialog   @relation(fields: [dialogId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model JLPTTest {
  id        String   @id @default(uuid())
  testId    String   @unique
  title     String
  level     String   // N1, N2, N3, N4, N5
  category  String   // Vocabulary, Grammar, Reading, Listening
  sections  String     // Array of sections with questions
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JLPTResult {
  id             String   @id @default(uuid())
  userId         String
  testId         String
  level          String
  category       String
  score          Int      // Percentage (0-100)
  totalQuestions Int
  correctAnswers Int
  answers        String     // Array of { questionId, selectedOption, isCorrect }
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}
