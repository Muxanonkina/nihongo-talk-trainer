generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String         @id @default(uuid())
  email     String         @unique
  password  String
  name      String?
  level     String         @default("N5")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  progress  UserProgress[]
}

model Dialog {
  id         String         @id @default(uuid())
  title      String
  category   String
  difficulty String
  script     Json
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  progress   UserProgress[]
}

model UserProgress {
  id        String   @id @default(uuid())
  userId    String
  dialogId  String
  score     Int
  feedback  String?
  createdAt DateTime @default(now())
  messages  Json?
  dialog    Dialog   @relation(fields: [dialogId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}
